{
  "opencollection": "1.0.0",
  "info": {
    "name": "Canoe API v1 Password Grant Tokens API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Password Grant Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
