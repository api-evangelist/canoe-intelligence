            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Access tokens provide access to all other endpoints within the API. This endpoint allows you to request access tokens securely without going through the OAuth2 authorization code redirect flow."
        }
      ]
    }
  ],
  "bundled": true
