        {
          "id": "0dac1618-e1fd-4cbb-b95b-96f5cafda876",
          "name": "Requesting Tokens - Client Credentials",
          "request": {
            "name": "Requesting Tokens - Client Credentials",
            "description": {
              "content": "/oauth/token\n\n<p>Once a client has been created, you may use the <code>Client ID</code> and <code>Client Secret</code> to request an\nto request an access token. Access tokens provide access to all other endpoints within the API.</p>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token",
                "client-credentials"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"<string>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "1f4745f0-5ad3-4bf1-8ef2-7858161e8efc",
              "name": "Success",
              "originalRequest": {
