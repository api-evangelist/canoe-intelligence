        {
          "id": "4e371d34-e6ae-46bd-98da-261733e061fe",
          "name": "Get Users Within Your Organization",
          "request": {
            "name": "Get Users Within Your Organization",
            "description": {
              "content": "Fetch information about users within your Canoe organization.\n\n<span name=\"doc-alert-info\">\nThis endpoint offers optional pagination. \nPagination supports the return of large results and is highly recommended for all use cases. \nUnpaginated calls will be depreciated in future versions of the Canoe API.\n<br><br>\nWhen using pagination, the response will contain headers defining the <code>total</code> number of results, \nas well as the <code>first</code>, <code>next</code>, <code>prev</code>, and <code>last</code> page responses for your result set. \nTo enable pagination pass a header parameter of X-API-VERSION with a value of 2024-12-12.\n</span>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "This page number. For example, if you specify \"2\" you will see all users on page 2. By default, this is set to 1. <u>This parameter is only valid if the X-API-VERSION header is set to 2024-12-12.</u> Example: 1"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The number of documents for each page. The maximum number of users limit is 100. <u>This parameter is only valid if the X-API-VERSION header is set to 2024-12-12.</u> Example: 50"
                },
                {
                  "disabled": false,
                  "key": "user_id",
                  "value": "<string>",
                  "description": "The IDs of the users in Canoe. Example: user_1,user_2"
                },
                {
                  "disabled": false,
                  "key": "email_id",
                  "value": "<string>",
                  "description": "The emails of the users in Canoe. Example: user_1@example.com,user_2@example.com"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
